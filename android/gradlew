#!/bin/sh
# Minimal Gradle launcher for AirKeys.
# If a system Gradle is present, use it; otherwise download Gradle 8.7
# (matching gradle/wrapper/gradle-wrapper.properties) once and run it.
# Replace this file with the official wrapper script generated by
# Android Studio (it creates gradlew + gradle/wrapper/gradle-wrapper.jar)
# if you prefer the stock wrapper — the build itself does not depend on it.
set -e
cd "$(dirname "$0")"
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
GRADLE_VERSION="8.7"
GRADLE_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/gradle-${GRADLE_VERSION}-bin"
if [ ! -x "$GRADLE_HOME/gradle-${GRADLE_VERSION}/bin/gradle" ]; then
  mkdir -p "$GRADLE_HOME"
  cd "$GRADLE_HOME"
  curl -L -o gradle.zip "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  unzip -q -o gradle.zip
  rm -f gradle.zip
  cd "$(dirname "$0")"
fi
exec "$GRADLE_HOME/gradle-${GRADLE_VERSION}/bin/gradle" "$@"
